diff --git a/src/index.ts b/src/index.ts
--- a/src/index.ts
+++ b/src/index.ts
@@ -62,11 +62,21 @@ app.use(
 app.use(
   cors({
-    origin: true, // Allow all origins — the Omada Custom Portal Page is served from unknown controller IPs
+    origin: (origin, callback) => {
+      const allowedOrigins = [env.FRONTEND_URL, env.PORTAL_URL].filter(Boolean);
+      // Allow requests with no origin (e.g. server-to-server webhooks, health probes)
+      if (!origin || allowedOrigins.includes(origin)) {
+        return callback(null, true);
+      }
+      // Omada custom portal pages are served from controller IPs; handle them
+      // via a separate public endpoint that does not rely on CORS credentials.
+      callback(new Error('CORS origin not allowed'));
+    },
     credentials: true,
     methods: ['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS'],
   })
 );
