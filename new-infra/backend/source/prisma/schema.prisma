// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum SubscriptionStatus {
  PENDING_ACTIVATION
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionPlan {
  BASIC
  STANDARD
  PREMIUM
}

enum UserRole {
  SUPER_ADMIN
  MERCHANT
}

enum RouterStatus {
  ONLINE
  OFFLINE
  ERROR
}

enum RouterVendor {
  MIKROTIK
  TPLINK
  OMADA
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum SessionStatus {
  PENDING
  ACTIVE
  EXPIRED
  DISCONNECTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  VOUCHER
  MONGIKE
  ANYPAY
  ZENOPAY_MOBILE
}

enum VoucherStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

// ─── Tenant ───────────────────────────────────────────────────────────────────

model Tenant {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  email           String       @unique
  phone           String?
  address         String?
  logoUrl         String?
  portalNoticeName String?
  portalNoticeMessage String?
  portalNoticeColor String?   @default("#2563eb")
  mongikApiKey    String?      // Tenant's own Mongike API key — payments go to their account (legacy plaintext)
  mongikApiKeyEnc String?      // Encrypted tenant payment key
  mongikWebhookToken String?   // Deprecated: legacy field retained for backward compatibility
  webhookSecret   String?      @unique // Per-tenant webhook token used to authenticate provider callbacks
  paymentProvider PaymentProvider @default(MONGIKE)
  anypayApiKey    String?      // AnyPay Tanzania API key (legacy plaintext)
  anypayApiKeyEnc String?      // Encrypted tenant payment key
  zenopayApiKey   String?      // ZenoPayMobile Tanzania API key (legacy plaintext)
  zenopayApiKeyEnc String?     // Encrypted tenant payment key
  status          TenantStatus @default(ACTIVE)
  subscription Subscription?
  routers      Router[]
  tplinkRouters TpLinkRouter[]
  omadaSites   OmadaSite[]
  plans        Plan[]
  sessions     Session[]
  payments     Payment[]
  users        User[]
  vouchers     Voucher[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("tenants")
}

// ─── Subscription ─────────────────────────────────────────────────────────────

model Subscription {
  id        String             @id @default(cuid())
  tenantId  String             @unique
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan   @default(BASIC)
  status    SubscriptionStatus @default(PENDING_ACTIVATION)
  startsAt  DateTime           @default(now())
  expiresAt DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("subscriptions")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(MERCHANT)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// ─── Router ───────────────────────────────────────────────────────────────────

model Router {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  ipAddress    String
  apiPort      Int          @default(8728)
  username     String
  passwordHash String       // legacy plaintext; to be removed after migration
  passwordEnc  String?      // encrypted router password
  provisioningKey String?   @unique
  serialNumber   String?    @unique
  hardwareMac    String?    @unique
  hotspotName  String       @default("hotspot1")
  location     String?
  status       RouterStatus @default(OFFLINE)
  lastSeenAt   DateTime?
  lastBootstrapAt DateTime?
  lastBootstrapIp String?
  provisionedAt DateTime?
  sessions     Session[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("routers")
}

// ─── TP-Link Router (OpenWrt-based) ───────────────────────────────────────────

model TpLinkRouter {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  ipAddress       String
  sshPort         Int          @default(22)
  username        String
  passwordHash    String       // legacy plaintext; to be removed after migration
  passwordEnc     String?      // encrypted router password
  provisioningKey String?      @unique
  serialNumber    String?      @unique
  hardwareMac     String?      @unique
  hotspotName     String       @default("nodogsplash1")
  openwrtVersion  String?
  location        String?
  status          RouterStatus @default(OFFLINE)
  lastSeenAt      DateTime?
  lastBootstrapAt DateTime?
  lastBootstrapIp String?
  provisionedAt   DateTime?
  sessions        Session[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("tplink_routers")
}

// ─── Plan ─────────────────────────────────────────────────────────────────────

model Plan {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  price         Decimal    @db.Decimal(10, 2)
  durationMins  Int        // duration in minutes
  downloadKbps  Int?       // null = unlimited
  uploadKbps    Int?
  dataLimitMb   Int?       // null = unlimited
  status        PlanStatus @default(ACTIVE)
  sessions      Session[]
  payments      Payment[]
  vouchers      Voucher[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("plans")
}

// ─── Session ──────────────────────────────────────────────────────────────────

model Session {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  routerId        String?
  router          Router?       @relation(fields: [routerId], references: [id])
  tplinkRouterId  String?
  tplinkRouter    TpLinkRouter? @relation(fields: [tplinkRouterId], references: [id])
  omadaSiteId     String?
  omadaSite       OmadaSite?    @relation(fields: [omadaSiteId], references: [id])
  vendor          RouterVendor  @default(MIKROTIK)
  planId          String
  plan            Plan          @relation(fields: [planId], references: [id])
  macAddress      String
  ipAddress       String?
  hotspotUsername String
  hotspotPassword String
  status          SessionStatus @default(PENDING)
  startsAt        DateTime?
  expiresAt       DateTime?
  bytesIn         BigInt        @default(0)
  bytesOut        BigInt        @default(0)
  payment         Payment?
  voucher         Voucher?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([macAddress])
  @@index([tenantId, status])
  @@index([routerId, status])
  @@index([tplinkRouterId, status])
  @@index([omadaSiteId, status])
  @@map("sessions")
}

// ─── Payment ──────────────────────────────────────────────────────────────────

model Payment {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  sessionId    String?       @unique
  session      Session?      @relation(fields: [sessionId], references: [id])
  planId       String?
  plan         Plan?          @relation(fields: [planId], references: [id])
  amount       Decimal       @db.Decimal(10, 2)
  currency     String        @default("TZS")
  phone        String?
  status       PaymentStatus @default(PENDING)
  provider     PaymentProvider @default(MONGIKE)
  mongikeTxId  String?       @unique
  mongikRef    String?
  zenopayRef   String?       @unique
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tenantId, status])
  @@index([mongikeTxId])
  @@map("payments")
}

// ─── Voucher ──────────────────────────────────────────────────────────────────

model Voucher {
  id           String        @id @default(cuid())
  code         String        @unique
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan          @relation(fields: [planId], references: [id])
  status       VoucherStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  expiresAt    DateTime?
  redeemedAt   DateTime?
  sessionId    String?       @unique
  session      Session?      @relation(fields: [sessionId], references: [id])
  redeemedMac  String?

  @@index([tenantId, status])
  @@index([code])
  @@map("vouchers")
}

// ─── RADIUS User (Omada integration) ──────────────────────────────────────────

model RadiusUser {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  sessionId   String   @unique @map("session_id")
  username    String   @unique
  password    String
  status      String   @default("ACTIVE")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([username])
  @@index([status])
  @@map("radius_users")
}

// ─── Omada Portal Token (single-use, short-lived credential exchange) ─────────

model OmadaSite {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  controllerUrl   String?      // Omada Controller URL (e.g. https://192.168.1.100:443)
  controllerIp    String?      // Controller IP for RADIUS client config
  radiusSecret    String       // Shared secret for FreeRADIUS (legacy plaintext)
  radiusSecretEnc String?      // Encrypted shared secret
  ssidName        String?      // WiFi SSID name (for reference)
  hotspotName     String       @default("omada1")
  location        String?
  status          RouterStatus @default(OFFLINE)
  lastSeenAt      DateTime?    // Updated when RADIUS auth requests come from this site
  provisionedAt   DateTime?    // Set when operator marks the site as configured
  sessions        Session[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId])
  @@map("omada_sites")
}

model OmadaPortalToken {
  id          String   @id @default(cuid())
  token       String   @unique
  sessionId   String   @unique @map("session_id")
  tenantId    String   @map("tenant_id")
  used        Boolean  @default(false)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([token])
  @@map("omada_portal_tokens")
}
