// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum SubscriptionStatus {
  PENDING_ACTIVATION
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionPlan {
  BASIC
  STANDARD
  PREMIUM
}

enum UserRole {
  SUPER_ADMIN
  MERCHANT
  INSTALLER
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
}

enum SiteStatus {
  ACTIVE
  SUSPENDED
}

enum SiteInstallationStatus {
  UNINSTALLED
  IN_PROGRESS
  ONLINE
  FAILED
}

enum InstallationStatus {
  DRAFT
  IN_PROGRESS
  WAITING_FOR_HARDWARE
  CONFIGURING
  VERIFYING
  COMPLETED
  FAILED
  CANCELLED
}

enum InstallationStage {
  CUSTOMER
  SITE
  HARDWARE
  WAN
  LAN
  WIFI
  CAPTIVE_PORTAL
  BILLING
  SECURITY
  VERIFICATION
  COMPLETION
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

enum RouterStatus {
  ONLINE
  OFFLINE
  ERROR
}

enum RouterVendor {
  MIKROTIK
  TPLINK
  OMADA
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum SessionStatus {
  PENDING
  ACTIVE
  EXPIRED
  DISCONNECTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  VOUCHER
  ANYPAY
}

enum VoucherStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

enum DeviceVendor {
  MIKROTIK
  TPLINK
  OMADA
  UBNT
  OPENWRT
  OTHER
}

enum DeviceType {
  ROUTER
  ACCESS_POINT
  SWITCH
  CONTROLLER
  OTHER
}

enum DeviceStatus {
  UNASSIGNED
  AVAILABLE
  RESERVED
  INSTALLING
  ACTIVE
  OFFLINE
  FAULTY
  RETIRED
}

enum DeviceProvisioningStatus {
  NOT_PROVISIONED
  DISCOVERING
  READY
  CONFIGURING
  VERIFYING
  PROVISIONED
  FAILED
}

enum DeviceIdentitySource {
  SCAN
  DISCOVERY
  HEARTBEAT
  MANUAL
}

enum HardwareTestResult {
  PASS
  FAIL
  INFO
  SKIP
}

// ─── Tenant ───────────────────────────────────────────────────────────────────

model Tenant {
  id                  String         @id @default(cuid())
  name                String
  slug                String         @unique
  email               String         @unique
  phone               String?
  address             String?
  logoUrl             String?
  portalNoticeName    String?
  portalNoticeMessage String?
  portalNoticeColor   String?        @default("#2563eb")
  webhookSecret       String?        @unique // Per-tenant webhook token used to authenticate provider callbacks
  anypayApiKey        String? // AnyPay Tanzania credential bundle (legacy plaintext)
  anypayApiKeyEnc     String? // Encrypted tenant AnyPay credential bundle
  anypayBaseUrl       String? // Optional AnyPay API base URL override
  anypayEnabled       Boolean        @default(true)
  status              TenantStatus   @default(ACTIVE)
  subscription        Subscription?
  routers             Router[]
  tplinkRouters       TpLinkRouter[]
  omadaSites          OmadaSite[]
  plans               Plan[]
  sessions            Session[]
  payments            Payment[]
  users               User[]
  vouchers            Voucher[]
  customers           Customer[]
  sites               Site[]
  installations       Installation[]
  devices             Device[]
  hardwareTestRuns    HardwareTestRun[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("tenants")
}

// ─── Subscription ─────────────────────────────────────────────────────────────

model Subscription {
  id        String             @id @default(cuid())
  tenantId  String             @unique
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan   @default(BASIC)
  status    SubscriptionStatus @default(PENDING_ACTIVATION)
  startsAt  DateTime           @default(now())
  expiresAt DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("subscriptions")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(MERCHANT)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  installations   Installation[]  @relation("InstallationInstaller")
  installerTokens InstallerToken[]
  installedDevices Device[]         @relation("DeviceInstaller")
  hardwareTestRuns HardwareTestRun[]

  @@map("users")
}

// ─── Router ───────────────────────────────────────────────────────────────────

model Router {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  ipAddress       String
  apiPort         Int          @default(8728)
  username        String
  passwordHash    String // legacy plaintext; to be removed after migration
  passwordEnc     String? // encrypted router password
  provisioningKey String?      @unique
  serialNumber    String?      @unique
  hardwareMac     String?      @unique
  hotspotName     String       @default("hotspot1")
  location        String?
  siteId          String?
  site            Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  model           String?      // reported by bootstrap/heartbeat (e.g. "hAP ac2")
  routerOsVersion String?      // reported RouterOS version
  discovery       Json?        // last RouterOS read-back snapshot
  discoveredAt    DateTime?
  status          RouterStatus @default(OFFLINE)
  lastSeenAt      DateTime?
  lastBootstrapAt DateTime?
  lastBootstrapIp String?
  provisionedAt   DateTime?
  sessions        Session[]
  device          Device?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("routers")
}

// ─── TP-Link Router (OpenWrt-based) ───────────────────────────────────────────

model TpLinkRouter {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  ipAddress       String
  sshPort         Int          @default(22)
  username        String
  passwordHash    String // legacy plaintext; to be removed after migration
  passwordEnc     String? // encrypted router password
  provisioningKey String?      @unique
  serialNumber    String?      @unique
  hardwareMac     String?      @unique
  hotspotName     String       @default("nodogsplash1")
  openwrtVersion  String?
  location        String?
  siteId          String?
  site            Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  status          RouterStatus @default(OFFLINE)
  lastSeenAt      DateTime?
  lastBootstrapAt DateTime?
  lastBootstrapIp String?
  provisionedAt   DateTime?
  sessions        Session[]
  device          Device?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("tplink_routers")
}

// ─── Plan ─────────────────────────────────────────────────────────────────────

model Plan {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  price        Decimal    @db.Decimal(10, 2)
  durationMins Int // duration in minutes
  downloadKbps Int? // null = unlimited
  uploadKbps   Int?
  dataLimitMb  Int? // null = unlimited
  status       PlanStatus @default(ACTIVE)
  sessions     Session[]
  payments     Payment[]
  vouchers     Voucher[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("plans")
}

// ─── Session ──────────────────────────────────────────────────────────────────

model Session {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  routerId        String?
  router          Router?       @relation(fields: [routerId], references: [id])
  tplinkRouterId  String?
  tplinkRouter    TpLinkRouter? @relation(fields: [tplinkRouterId], references: [id])
  omadaSiteId     String?
  omadaSite       OmadaSite?    @relation(fields: [omadaSiteId], references: [id])
  vendor          RouterVendor  @default(MIKROTIK)
  planId          String
  plan            Plan          @relation(fields: [planId], references: [id])
  macAddress      String
  ipAddress       String?
  hotspotUsername String
  hotspotPassword String
  status          SessionStatus @default(PENDING)
  startsAt        DateTime?
  expiresAt       DateTime?
  bytesIn         BigInt        @default(0)
  bytesOut        BigInt        @default(0)
  payment         Payment?
  voucher         Voucher?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([macAddress])
  @@index([tenantId, status])
  @@index([routerId, status])
  @@index([tplinkRouterId, status])
  @@index([omadaSiteId, status])
  @@map("sessions")
}

// ─── Payment ──────────────────────────────────────────────────────────────────

model Payment {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  sessionId    String?         @unique
  session      Session?        @relation(fields: [sessionId], references: [id])
  planId       String?
  plan         Plan?           @relation(fields: [planId], references: [id])
  amount       Decimal         @db.Decimal(10, 2)
  currency     String          @default("TZS")
  phone        String?
  status       PaymentStatus   @default(PENDING)
  provider     PaymentProvider @default(ANYPAY)
  providerTxId String?         @unique
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([tenantId, status])
  @@index([providerTxId])
  @@map("payments")
}

// ─── Voucher ──────────────────────────────────────────────────────────────────

model Voucher {
  id          String        @id @default(cuid())
  code        String        @unique
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId      String
  plan        Plan          @relation(fields: [planId], references: [id])
  status      VoucherStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  expiresAt   DateTime?
  redeemedAt  DateTime?
  sessionId   String?       @unique
  session     Session?      @relation(fields: [sessionId], references: [id])
  redeemedMac String?

  @@index([tenantId, status])
  @@index([code])
  @@map("vouchers")
}

// ─── RADIUS User (Omada integration) ──────────────────────────────────────────

model RadiusUser {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  sessionId String   @unique @map("session_id")
  username  String   @unique
  password  String
  status    String   @default("ACTIVE")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([username])
  @@index([status])
  @@map("radius_users")
}

// ─── Omada Portal Token (single-use, short-lived credential exchange) ─────────

model OmadaSite {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  controllerUrl   String? // Omada Controller URL (e.g. https://192.168.1.100:443)
  controllerIp    String? // Controller IP for RADIUS client config
  radiusSecret    String // Shared secret for FreeRADIUS (legacy plaintext)
  radiusSecretEnc String? // Encrypted shared secret
  ssidName        String? // WiFi SSID name (for reference)
  hotspotName     String       @default("omada1")
  location        String?
  siteId          String?
  site            Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  status          RouterStatus @default(OFFLINE)
  lastSeenAt      DateTime? // Updated when RADIUS auth requests come from this site
  provisionedAt   DateTime? // Set when operator marks the site as configured
  sessions        Session[]
  device          Device?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId])
  @@map("omada_sites")
}

model OmadaPortalToken {
  id        String   @id @default(cuid())
  token     String   @unique
  sessionId String   @unique @map("session_id")
  tenantId  String   @map("tenant_id")
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@map("omada_portal_tokens")
}

// ─── Platform Settings (singleton row, SUPER_ADMIN-managed) ──────────────────

model PlatformSetting {
  id            Int      @id @default(1)
  anypayKeyEnc  String? // Encrypted platform AnyPay credential bundle (activation + subscription fees)
  anypayBaseUrl String? // Optional AnyPay API base URL override
  anypayEnabled Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@map("platform_settings")
}

// ─── Customer (the WiFi business receiving service — distinct from Tenant) ────
//
// Tenant = the Triva business account (billing/subscription boundary).
// Customer = the client's business that is receiving a WiFi installation.
// A tenant (e.g. an ISP operating Triva) may install for many customers.

model Customer {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  contactName String?
  phone       String?
  email       String?
  status      CustomerStatus @default(ACTIVE)
  metadata    Json?
  sites       Site[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([tenantId])
  @@map("customers")
}

// ─── Site (one physical premises; groups devices + installations) ────────────

model Site {
  id                 String                  @id @default(cuid())
  tenantId           String
  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name               String
  address            String?
  location           String?                 // free-text or "lat,lon"
  status             SiteStatus              @default(ACTIVE)
  installationStatus SiteInstallationStatus  @default(UNINSTALLED)
  metadata           Json?
  routers            Router[]
  tplinkRouters      TpLinkRouter[]
  omadaSites         OmadaSite[]
  installations      Installation[]
  devices            Device[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@map("sites")
}

// ─── Installation (one physical installation event) ───────────────────────────
//
// Persists the structured configuration contract:
//   requestedConfig  — what the installer/wizard asked for
//   validatedConfig  — what the policy validator approved
//   executedConfig   — what the configuration engine actually applied
// revision is bumped on every validate/execute pass (optimistic concurrency).

model Installation {
  id              String             @id @default(cuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId          String
  site            Site               @relation(fields: [siteId], references: [id])
  installerId     String
  installer       User               @relation("InstallationInstaller", fields: [installerId], references: [id])
  status          InstallationStatus @default(DRAFT)
  stage           InstallationStage  @default(CUSTOMER)
  failureReason   String?
  contractVersion String             @default("1.0")
  revision        Int                @default(0)
  idempotencyKey  String?            @unique
  requestedConfig  Json?
  validatedConfig  Json?
  executedConfig   Json?
  executionResults Json?             // ordered action results [{actionId,type,status,evidence,error}]
  approvals        Json?             // [{step,by,at,method}]
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  metadata         Json?
  secrets          InstallationSecret[]
  tokens           InstallerToken[]
  devices          Device[]
  testRuns         HardwareTestRun[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([tenantId])
  @@index([siteId])
  @@index([installerId])
  @@index([status])
  @@map("installations")
}

// ─── Installer scoped token (revocable, short-lived, audit-linked) ───────────
//
// Login JWTs prove identity; InstallerTokens authorize work on one
// installation. jti is stored so a leaked token can be revoked.

model InstallerToken {
  id             String        @id @default(cuid())
  jti            String        @unique
  installerId    String
  installer      User          @relation(fields: [installerId], references: [id], onDelete: Cascade)
  tenantId       String
  installationId String?
  installation   Installation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  siteId         String?
  scopes         String[]      // e.g. ["install:read","install:execute"]
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())

  @@index([installerId])
  @@index([tenantId])
  @@map("installer_tokens")
}

// ─── Installation secret (PPPoE creds, controller creds, admin passwords) ────
//
// Values are AES-256-GCM encrypted and referenced everywhere else by
// secretRef "secret://installation/<installationId>/<secretId>" — never inline.

model InstallationSecret {
  id             String       @id @default(cuid())
  installationId String
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  kind           String       // e.g. "pppoe", "omada-controller", "router-admin"
  label          String?
  valueEnc       String       // AES-256-GCM ciphertext (ROUTER_CREDENTIALS_KEY)
  consumedAt     DateTime?    // set once the executor has used it
  createdAt      DateTime     @default(now())

  @@index([installationId])
  @@map("installation_secrets")
}

// ─── Audit log ────────────────────────────────────────────────────────────────
//
// Append-only record of every sensitive action. metadata is sanitized before
// write (see services/audit.service.ts) — secrets must never land here.

model AuditLog {
  id             String      @id @default(cuid())
  tenantId       String?
  userId         String?     // actor (installer/merchant/admin); null = system
  installationId String?
  siteId         String?
  action         String      // e.g. INSTALLATION_CREATED, DEVICE_CLAIMED
  targetType     String?     // e.g. "router", "site", "plan"
  targetId       String?
  result         AuditResult @default(SUCCESS)
  correlationId  String?     // request/installation correlation
  metadata       Json?       // sanitized — never contains secrets
  createdAt      DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([installationId])
  @@index([action])
  @@map("audit_logs")
}

// ─── Device (first-class physical inventory/identity record) ─────────────────
//
// Device is the canonical "this physical box exists and is owned by tenant X,
// installed at site Y" record. It links to the operational provisioning
// records (Router / TpLinkRouter / OmadaSite) which carry credentials and
// runtime state — Device carries identity, ownership, and lifecycle.

model Device {
  id                 String                    @id @default(cuid())
  tenantId           String
  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId             String?
  site               Site?                     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  vendor             DeviceVendor
  deviceType         DeviceType
  model              String?
  serialNumber       String?                   @unique
  macAddress         String?                   @unique
  assetTag           String?
  barcodeValue       String?                   @unique
  identitySource     DeviceIdentitySource      @default(MANUAL)
  status             DeviceStatus              @default(UNASSIGNED)
  provisioningStatus DeviceProvisioningStatus  @default(NOT_PROVISIONED)
  // linked operational records (one device → at most one live asset)
  routerId           String?                   @unique
  router             Router?                   @relation(fields: [routerId], references: [id], onDelete: SetNull)
  tpLinkRouterId     String?                   @unique
  tpLinkRouter       TpLinkRouter?             @relation(fields: [tpLinkRouterId], references: [id], onDelete: SetNull)
  omadaSiteId        String?                   @unique
  omadaSite          OmadaSite?                @relation(fields: [omadaSiteId], references: [id], onDelete: SetNull)
  // provenance
  installedById      String?
  installedBy        User?                     @relation("DeviceInstaller", fields: [installedById], references: [id], onDelete: SetNull)
  installationId     String?
  installation       Installation?             @relation(fields: [installationId], references: [id], onDelete: SetNull)
  lastSeenAt         DateTime?
  installedAt        DateTime?
  retiredAt          DateTime?
  metadata           Json?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([tenantId])
  @@index([siteId])
  @@index([status])
  @@map("devices")
}

// ─── Hardware test run (lab-mode evidence capture) ───────────────────────────
//
// Records one physical test against real hardware: who ran it, on which
// device, against which config version, with what result and evidence.

model HardwareTestRun {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId         String?
  deviceId       String?
  installationId String?
  installation   Installation?      @relation(fields: [installationId], references: [id], onDelete: SetNull)
  operatorId     String
  operator       User               @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  testName       String             // e.g. "DISCOVER_ROUTER", "PORTAL_REDIRECT"
  result         HardwareTestResult
  durationMs     Int?
  configVersion  String?
  logs           Json?              // sanitized evidence — never secrets
  createdAt      DateTime           @default(now())

  @@index([tenantId, createdAt])
  @@index([deviceId])
  @@map("hardware_test_runs")
}
