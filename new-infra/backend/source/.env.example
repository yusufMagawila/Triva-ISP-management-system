# Backend Environment Variables
# Copy this to .env and fill in your values. NEVER commit .env to Git.

# ── App ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Public URL of the backend (used for webhook callbacks)
APP_URL=https://api.yourdomain.com

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/triva

# ── Auth ────────────────────────────────────────────────────────────────────────
# Generate a strong 64+ character secret:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_A_VERY_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
PORTAL_URL=http://localhost:5174

# ── Encryption keys (32 bytes, base64 or 64 hex chars) ────────────────────────────
# Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ROUTER_CREDENTIALS_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
TENANT_KEYS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ── Mongike Payment Gateway ──────────────────────────────────────────────────────
MONGIKE_API_KEY=your_mongike_api_key_here
MONGIKE_API_URL=https://mongike.com
