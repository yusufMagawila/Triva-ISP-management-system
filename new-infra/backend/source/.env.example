# Backend Environment Variables
# Copy this to .env and fill in your values. NEVER commit .env to Git.

# ── App ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Public URL of the backend (used for webhook callbacks)
APP_URL=https://api.yourdomain.com

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/triva

# ── Auth ────────────────────────────────────────────────────────────────────────
# Generate a strong 64+ character secret:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_A_VERY_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
PORTAL_URL=http://localhost:5174

# ── Encryption keys (32 bytes, base64 or 64 hex chars) ────────────────────────────
# Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ROUTER_CREDENTIALS_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
TENANT_KEYS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ── Payments (AnyPay) ────────────────────────────────────────────────────────────
# AnyPay is configured per-tenant (merchant collections) and at platform level
# (activation/subscription fees) through the admin panel. Credentials are
# encrypted at rest with TENANT_KEYS_ENCRYPTION_KEY — no payment secrets in env.
# Platform webhook shared secret for activation/subscription callbacks (>=32 chars)
ACTIVATION_WEBHOOK_SECRET=generate-32-char-random-secret

# ── AI (optional — Phase 5C) ─────────────────────────────────────────────────────
# AI provider for installation planning/diagnostics. Output is schema-validated
# and allowlist-gated — the AI never executes anything. Server-side only;
# never expose the key to the frontend.
#   AI_PROVIDER=gemini | deterministic   (deterministic = safe no-LLM fallback)
AI_PROVIDER=deterministic
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
