# Triva WiFi — New VPS environment template
# Copy to .env and fill in all values. Never commit .env to Git.

# PostgreSQL
DB_HOST=postgres
DB_USER=triva_user
DB_PASSWORD=change-me-strong-password
DB_NAME=triva_db

# Backend
NODE_ENV=production
PORT=4000
JWT_SECRET=generate-64-char-random-hex-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://dashboard.triva.example.com
PORTAL_URL=https://triva.example.com
APP_URL=https://triva.example.com
DASHBOARD_URL=https://app.triva.example.com

# AI setup assistant (optional). Set in Dokploy secrets only; backend-only.
AI_PROVIDER=deterministic
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Build-time API URL for the Vite dashboard (must match where the backend is served)
VITE_API_URL=https://api.triva.example.com

# Payments (AnyPay)
# AnyPay credentials are configured in the admin panel (tenant portal payments
# under Settings, platform activation/subscription fees under Admin). They are
# encrypted at rest — do not put provider secrets in env.
# Platform webhook shared secret for activation/subscription callbacks (>=32 chars)
ACTIVATION_WEBHOOK_SECRET=generate-32-char-random-secret

# Encryption keys (32 bytes, base64 or 64 hex chars)
ROUTER_CREDENTIALS_KEY=base64-or-hex-32-byte-key
TENANT_KEYS_ENCRYPTION_KEY=base64-or-hex-32-byte-key

# Backup
BACKUP_DIR=/var/backups/triva
BACKUP_REMOTE=
RETENTION_DAYS=14

COMPOSE_PROFILES=
OMADA_CONTROLLER_URL=
OMADA_ADMIN_BIND=127.0.0.1
RADIUS_PUBLIC_HOST=
RADIUS_BIND_ADDRESS=127.0.0.1
